{
  "name": "touch-grass",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-user website: a Socket.IO server, made public with a Cloudflare tunnel.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
